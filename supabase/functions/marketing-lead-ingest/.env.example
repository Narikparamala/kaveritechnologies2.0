# =====================================================================
# marketing-lead-ingest — environment contract (placeholders only)
# Set these as Supabase function secrets / dashboard. NEVER commit real
# values. Nothing here may ever reach the browser bundle or VITE_*.
# =====================================================================

# --- Lead ingestion authorization ---
# Shared HMAC secret between the marketing app and this Edge Function.
# The marketing app signs requests with this secret; this function verifies.
# MUST be at least 32 bytes (UTF-8). Generate with: openssl rand -hex 32
# If set, this env value wins; otherwise the function reads vault secret
# 'marketing.lead.secret'.
KAVERI_LEAD_API_SECRET=replace_with_at_least_32_random_bytes

# --- Supabase runtime (normally injected automatically) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
# SUPABASE_SERVICE_ROLE_KEY is secret: used only inside the function,
# never client-side. It lets the function call the ingest RPC with
# service-role privileges (bypasses RLS).
