# =====================================================================
# secure-grade function — environment contract (placeholders only)
# Set these in the Supabase project's function secrets / dashboard.
# NEVER commit real values. Runner tokens must never reach the
# browser bundle or any VITE_* variable.
# =====================================================================

# --- Built-in runner (default) ---------------------------------------
# Serverless Python runner deployed with the web app on Vercel
# (api/execute.py). Takes priority when both values are set.
# URL is the exact endpoint, e.g. https://kaveri-academy.vercel.app/api/execute
KAVERI_EXECUTE_URL=https://your-app.vercel.app/api/execute
# Strong random token shared ONLY with the runner function.
# Generate with: openssl rand -hex 32   (also set as EXECUTE_TOKEN on Vercel)
KAVERI_EXECUTE_TOKEN=replace_with_64_hex_chars

# --- Dedicated runner (go-judge) --------------------------------------
# Overrides the built-in runner when both are set. Use when the institute
# moves to a dedicated always-on host (Oracle free VM / institute server).
GO_JUDGE_URL=https://judge.kaveritech.co.in/
GO_JUDGE_TOKEN=replace_with_64_hex_chars

# --- Legacy Judge0 adapter (kept for future use; not used) ------------
# When neither runner above is configured, secure-grade falls back to
# Judge0. Judge0 is NOT deployed for production.
JUDGE0_URL=
JUDGE0_AUTHN_HEADER=X-Auth-Token
JUDGE0_AUTHN_TOKEN=
JUDGE0_AUTHZ_HEADER=X-Auth-User
JUDGE0_AUTHZ_TOKEN=

# --- Supabase runtime (normally injected automatically) ---------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_project_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
# SUPABASE_SERVICE_ROLE_KEY is secret: used only inside the function, never client-side.

# --- Browser origins allowed to call the function (CORS) --------------
# Comma-separated. Must include the real production origin(s).
LMS_ALLOWED_ORIGINS=https://www.kaveritech.co.in
