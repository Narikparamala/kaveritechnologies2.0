# =====================================================================
# notification-mailer — environment contract (placeholders only)
# Set these as Supabase function secrets / dashboard. NEVER commit real
# values. Nothing here may ever reach the browser bundle or VITE_*.
# =====================================================================

# --- Mailer authorization ---
# Shared service-to-service token. The DB outbox worker reads the SAME
# token from supabase_vault (secret name: notification_mailer_token) and
# sends it in the X-Kaveri-Mailer-Token header (a custom header — the
# edge-runtime JWT gateway intercepts Authorization, so we never use it
# for this token). If set, this env value wins; otherwise the function
# reads vault. Generate with: openssl rand -hex 32
NOTIFICATION_MAILER_TOKEN=replace_with_64_hex_chars

# --- Provider (adapter is isolated in _shared/provider.ts) ---
# FAILS CLOSED: MAILER_PROVIDER must be explicitly set (env wins, else the
# vault secret 'mailer_provider'); missing/unknown → PROVIDER_NOT_CONFIGURED
# and nothing is ever marked sent.
#   log    = local/mock provider: renders + logs, never sends externally.
#            An outbox payload with dev_fail_mode=transient|permanent makes
#            the log provider simulate provider failures (LOCAL QA ONLY).
#   resend = transactional email via Resend
MAILER_PROVIDER=resend
# Only needed when MAILER_PROVIDER=resend:
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM=Kaveri Technologies Academy <noreply@kaveritech.co.in>

# --- Public link base used inside templates ---
LMS_PUBLIC_URL=http://localhost:5173

# --- Supabase runtime (normally injected automatically) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
# SUPABASE_SERVICE_ROLE_KEY is secret: used only inside the function,
# never client-side. It lets the mailer claim/resolve outbox rows and
# read the mailer token from vault (get_server_secret RPC).